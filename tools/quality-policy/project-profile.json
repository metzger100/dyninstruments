{
  "schemaVersion": 1,
  "profileType": "product-quality-profile",
  "product": {
    "id": "viewer-widget",
    "runtime": "browser"
  },
  "portableCore": {
    "coreVersion": "3.2.0",
    "roleGraph": "tools/quality-policy/portable-role-graph.json"
  },
  "sourceScopes": [
    { "id": "runtime", "roots": ["runtime", "shared", "widgets", "cluster"] },
    { "id": "tests", "roots": ["tests"] }
  ],
  "languages": {
    "javascript": true,
    "typescript": true,
    "css": true,
    "markdown": true
  },
  "testProjects": [
    { "id": "unit-node", "command": "npm run test:node", "paths": ["tests"] },
    { "id": "unit-dom", "command": "npm run test:dom", "paths": ["tests"] }
  ],
  "policies": {
    "coverage": "tools/quality-policy/coverage-floors.json",
    "complexity": "tools/quality-policy/complexity-budget.mjs",
    "fileSize": "tools/quality-policy/project-file-size-scope.json"
  },
  "documentation": {
    "roots": ["README.md", "documentation", "CONTRIBUTING.md"]
  },
  "adapters": {
    "setup": "npm run setup",
    "standard": "npm run check:standard",
    "suppressions": "npm run check:suppressions",
    "typing": "npm run typecheck",
    "packaging": "npm run package:check",
    "focus": "npm run test:focus:check",
    "smells": "npm run check:smells",
    "product-contracts": "npm run test:contract",
    "test-split": "npm run test:node && npm run test:dom",
    "complexity": "npm run check:complexity",
    "scaling": "npm run check:scaling",
    "documentation": "npm run docs:check",
    "file-size": "npm run check:filesize",
    "coverage": "npm run test:coverage:check"
  }
}
