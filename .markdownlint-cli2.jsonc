{
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "artifacts/**",
    "coverage/**",
    "exec-plans/completed/**",
    "releases/**",
    // Byte-for-byte extracted verbatim from AGENTS.md's SHARED_INSTRUCTIONS block; its leading
    // blank lines are a mechanical artifact of the extraction boundary, not authored prose.
    "tools/quality-policy/shared-instructions.md"
  ],
  "config": {
    "default": true,
    // Long lines are Prettier's proseWrap responsibility, not markdownlint's.
    "MD013": false,
    // Inline HTML (e.g. status badges, raw <br>) is intentionally allowed in maintained docs.
    "MD033": false,
    // Not every maintained doc needs a top-level H1 immediately (e.g. skill/README fragments).
    "MD041": false
  }
}
