{
  "name": "dyninstruments",
  "version": "0.0.0-test",
  "private": true,
  "description": "Dev-only tooling for dyninstruments tests",
  "scripts": {
    "setup": "npm ci && bash tools/actionlint.sh --install",
    "hooks:install": "node tools/hooks-install.mjs",
    "hooks:doctor": "node tools/hooks-doctor.mjs",
    "docs:check": "npm run docs:lint && npm run docs:links:proof && npm run docs:links && npm run check:doclinks && npm run check:docformat && npm run check:reachability",
    "docs:links": "node tools/check-doc-links.mjs",
    "docs:links:proof": "node tools/check-doc-links-proof.mjs",
    "docs:lint": "markdownlint-cli2",
    "check:doclinks": "vitest run --project contract tests/contract/documentation-links-contract.test.js",
    "check:reachability": "vitest run --project contract tests/contract/documentation-reachability-contract.test.js",
    "check:docformat": "vitest run --project contract tests/contract/documentation-format-contract.test.js",
    "check:filesize": "node tools/check-file-size.mjs --oneliner=block",
    "check:filesize:warn": "echo \"[exploratory] filesize checker with warn-only oneliner mode\" && node tools/check-file-size.mjs --oneliner=warn",
    "check:patterns": "node tools/check-patterns.mjs",
    "check:shared-core": "node tools/check-shared-core.mjs",
    "check:generic-surface": "node tools/check-generic-surface.mjs && npm run check:generic-conformance",
    "check:generic-conformance": "node tools/check-generic-conformance.mjs",
    "check:generic-surface:warn": "node tools/check-generic-surface.mjs --warn",
    "check:profile": "node tools/check-quality-profile.mjs",
    "check:standalone": "node tools/check-standalone-boundary.mjs",
    "check:suppressions": "node tools/portable-core/suppression-engine.mjs",
    "portable-core:attest": "node tools/portable-core-attest.mjs",
    "starter:create": "node tools/create-avnav-plugin-starter.mjs",
    "check:complexity": "node tools/quality-policy/complexity-capture-integrity.mjs && node tools/quality-policy/complexity-budget.mjs",
    "complexity:regenerate-audit": "node tools/quality-policy/historical-complexity-capture.mjs --check",
    "check:scaling": "vitest run tests/tools/operation-count-evaluator.test.js tests/contract/route-points-render-model-scaling-contract.test.js tests/shared/html/HtmlDomPatchUtils.scaling-contract.test.js tests/shared/text/TextLayoutPrimitives.scaling-contract.test.js",
    "format:scope": "node tools/quality-policy/generate-format-scope.mjs",
    "format": "node tools/quality-policy/run-format.mjs --write",
    "format:check": "node tools/quality-policy/run-format.mjs --check",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:css": "stylelint \"plugin.css\" \"shared/**/*.css\" \"widgets/**/*.css\" \"tests/css/**/*.css\"",
    "lint:js": "eslint .",
    "actions:lint": "bash tools/actionlint.sh -color",
    "test:focus:check": "node tools/check-test-focus.mjs",
    "typecheck:source": "tsc -p tsconfig.checkjs.json",
    "typecheck:tests": "node tools/quality-policy/test-inventory.mjs && tsc -p tsconfig.tests.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck": "npm run typecheck:source && npm run typecheck:tests && npm run typecheck:tools",
    "schema:check": "node tools/check-schema.mjs",
    "test:package": "vitest run --project unit-node tests/tools/release-prepare.test.js tests/tools/release-create.test.js tests/tools/release-zip-builder.test.js",
    "package:check": "npm run schema:check && npm run test:package",
    "duplication:check": "jscpd --config jscpd.config.json --exit-code=1",
    "check:standard": "npm run format:check && npm run lint && npm run actions:lint && npm run duplication:check",
    "check:smells": "npm run check:patterns && npm run check:generic-surface",
    "check:fast": "npm run check:standard && npm run typecheck && npm run test:unit",
    "check:core": "node tools/portable-core/gate-orchestrator.mjs --roles standard,portable-core,generic-surface,standalone,suppressions,typing,packaging,focus,smells,product-contracts,test-split,complexity,scaling,documentation,file-size",
    "release:prepare": "node tools/release-prepare.mjs",
    "release:create": "node tools/release-create.mjs",
    "check:all": "npm run check:core && npm run test:coverage:check",
    "check:strict": "npm run check:all",
    "test": "vitest run",
    "test:contract": "vitest run --project contract",
    "test:dom": "vitest run --project unit-dom",
    "test:node": "vitest run --project unit-node",
    "test:split": "npm run test:node && npm run test:dom",
    "test:unit": "vitest run --project unit-node --project unit-dom",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:coverage-inventory": "node tools/quality-policy/check-coverage-inventory.mjs",
    "test:coverage:check": "npm run test:coverage && npm run check:coverage-inventory",
    "dependencies:audit": "npm audit"
  },
  "engines": {
    "node": ">=26 <27",
    "npm": "12.0.1"
  },
  "packageManager": "npm@12.0.1",
  "overrides": {
    "js-yaml": "5.2.2",
    "fast-uri": "3.1.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "acorn": "8.17.0",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "eslint": "10.8.0",
    "eslint-plugin-jsdoc": "63.0.13",
    "fast-check": "4.9.0",
    "globals": "17.8.0",
    "jscpd": "5.0.12",
    "jsdom": "26.0.0",
    "jsonc-parser": "3.3.1",
    "linkinator": "8.0.2",
    "markdownlint-cli2": "0.23.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
